# Скопируйте этот файл в .env и укажите свой ключ. Файл .env не попадает в git.

# --- Вариант 1: Claude (по умолчанию) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Глубина рассуждений: low | medium | high. Для узких ролей агентов достаточно low.
LLM_EFFORT=low
ANTHROPIC_API_KEY=

# --- Вариант 2: Gemini, бесплатно (ключ: aistudio.google.com → Get API key) ---
# Проверено на gemini-3.5-flash и gemini-3.5-flash-lite (ответ за 1–5 с); gemini-3.8-flash на бесплатном
# тарифе отвечал 15–90 с. Дневная квота бесплатного тарифа — у каждой модели своя и небольшая
# (у gemini-3.5-flash — 20 запросов в день, т.е. ~3 запуска). Закончилась — смените модель.
# LLM_PROVIDER=openai
# LLM_MODEL=gemini-3.5-flash
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=

# --- Вариант 3: другой OpenAI-совместимый провайдер с поддержкой tool calling ---
# LLM_PROVIDER=openai
# LLM_MODEL=<модель провайдера>
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1      # OpenAI
# OPENAI_BASE_URL=https://api.groq.com/openai/v1 # Groq
# OPENAI_BASE_URL=http://localhost:11434/v1      # Ollama (OPENAI_API_KEY=ollama)

# --- Лимиты и защита от зацикливания ---
MAX_AGENT_STEPS=6
MAX_TOTAL_STEPS=40
TASK_TIMEOUT_S=180
HTTP_TIMEOUT_S=20
HTTP_RETRIES=3
CACHE_TTL_S=3600
